cabal-version:       >=1.10

name:                GHUT

version:             0.0.1
synopsis:            A simple testing library for Haskell.
-- description:
homepage:            henrywandover.com
-- bug-reports:
license:             BSD3
license-file:        LICENSE
author:              Henry Wandover
maintainer:          henrywandover@gmail.com
-- copyright:
category:            Testing
build-type:          Simple
extra-source-files:  CHANGELOG.md, README.md

source-repository head
  type: git
  location: https://github.com/yung-turabian/ghut

library
  hs-source-dirs:      src
  build-depends:       
    base ==4.*
  exposed-modules:     
    Test.GHUT.Base
		Test.GHUT
  -- Modules included in this library but not exported.
  -- other-modules:
  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  -- Directories containing source files.
  -- hs-source-dirs:
  -- Base language which the package is written in.
  default-language:    Haskell2010
  ghc-options: -Wall
